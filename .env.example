# Server-only. Direct Postgres connection string (via Supabase's connection
# pooler in staging/prod; the local Supabase stack's own Postgres locally).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Server-only. Used for Supabase Auth admin operations (verifying admin
# bearer tokens, Storage signed URLs) — bypasses Row Level Security.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to sign the reservation session cookie.
SESSION_COOKIE_SECRET=

# Test-only override for E2E reservation-expiry scenarios. Never set outside
# local/CI test runs.
RESERVATION_TTL_MINUTES_OVERRIDE=
